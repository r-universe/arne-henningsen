[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "maxLik"]
	path = maxLik
	url = https://github.com/arne-henningsen/maxlik
[submodule "micEcon"]
	path = micEcon
	url = https://github.com/cran/micEcon
[submodule "micEconAids"]
	path = micEconAids
	url = https://github.com/cran/micEconAids
[submodule "micEconIndex"]
	path = micEconIndex
	url = https://github.com/cran/micEconIndex
[submodule "micEconSNQP"]
	path = micEconSNQP
	url = https://github.com/cran/micEconSNQP
[submodule "miscTools"]
	path = miscTools
	url = https://github.com/arne-henningsen/misctools
[submodule "urbin"]
	path = urbin
	url = https://github.com/arne-henningsen/urbin
